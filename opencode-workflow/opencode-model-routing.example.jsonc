// Copy only the installed subagent entries into your OpenCode V2 config after choosing models.
// Replace every <...> value with a provider/model slug OpenCode lists for you.
// Do not install this file as-is. It is JSONC documentation, not valid config.
// For inherit-parent/auto, omit that agent's model property instead.
// Selecting a primary agent does not change the session model.
{
  "agents": {
    "research": {
      "model": "<low-cost-research-model>"
    },
    "worker": {
      "model": "<best-price-performance-coding-model>"
    },
    "expert": {
      "model": "<strongest-reasoning-model>"
    },
    "ci-watcher": {
      "model": "<low-cost-research-model>"
    },
    "comments": {
      "model": "<low-cost-research-model>"
    },
    "compat-scan": {
      "model": "<low-cost-research-model>"
    },
    "compat-startup": {
      "model": "<low-cost-research-model>"
    },
    "compat-verify": {
      "model": "<low-cost-research-model>"
    },
    "compat-docs": {
      "model": "<low-cost-research-model>"
    },
    "learn": {
      "model": "<best-price-performance-coding-model>"
    },
    "thermos-review": {
      "model": "<best-price-performance-coding-model>"
    },
    "thermos-quality": {
      "model": "<best-price-performance-coding-model>"
    }
  }
}
